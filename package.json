{
  "name": "local-model-workshop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "eval": "vite-node scripts/eval-sig.ts --",
    "eval:mock": "vite-node scripts/eval-sig.ts -- --mock-only --out eval/results/mock-only",
    "audit:score": "vite-node scripts/audit-report.ts --write",
    "audit:infer": "vite-node scripts/audit-infer.ts --",
    "audit:inspect": "vite-node scripts/audit-inspector.ts --write",
    "audit:rescore": "vite-node scripts/audit-rescore.ts --"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "license": "MIT"
}
